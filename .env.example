# Copiar a .env.local. Nunca commitear valores reales.
# Postgres: la web se conecta SIEMPRE como kinesiapp_app (sujeto a RLS).
# En Supabase, con el pooler (modo transacción, puerto 6543): usuario kinesiapp_app.<project-ref>
DATABASE_URL=postgres://kinesiapp_app:local_app_pw@127.0.0.1:54322/kinesiapp_dev
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Interruptor de emergencia del refresco de sesión en el proxy (1 = apagado)
SESSION_REFRESH_DISABLED=
